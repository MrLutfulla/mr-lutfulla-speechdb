{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "recordingCount": {
            "type": "number",
            "description": "The number of recordings the user has made."
        }
      },
      "required": ["uid"]
    },
    "Recording": {
      "title": "Recording",
      "description": "Represents a single audio recording and its metadata.",
      "type": "object",
      "properties": {
        "audioUrl": {
          "type": "string",
          "format": "uri",
          "description": "Public URL to the audio file in Cloud Storage."
        },
        "storagePath": {
            "type": "string",
            "description": "The path to the audio file in Cloud Storage."
        },
        "speakerId": {
          "type": "string",
          "description": "Anonymized ID for the speaker."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the recording was created."
        },
        "emotion": {
          "type": "string",
          "description": "The emotion expressed in the recording."
        },
        "intensity": {
          "type": "string",
          "enum": ["normal", "strong"]
        },
        "textId": {
          "type": "string",
          "description": "ID of the text that was read."
        },
        "gender": {
          "type": "string",
          "enum": ["male", "female"]
        },
        "age": {
          "type": "string",
          "description": "Age range of the speaker."
        },
        "region": {
          "type": "string",
          "description": "Geographical region of the speaker."
        },
        "personality": {
          "type": "object",
          "properties": {
            "extrovert": { "type": "boolean" },
            "introvert": { "type": "boolean" },
            "optimistic": { "type": "boolean" },
            "emotional": { "type": "boolean" },
            "calm": { "type": "boolean" },
            "analytical": { "type": "boolean" },
            "leader": { "type": "boolean" },
            "compassionate": { "type": "boolean" }
          }
        }
      },
      "required": [
        "audioUrl",
        "storagePath",
        "speakerId",
        "createdAt",
        "emotion",
        "intensity",
        "textId"
      ]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Stores public profile information for each user."
    },
    "/users/{userId}/recordings/{recordingId}": {
      "schema": { "$ref": "#/backend/entities/Recording" },
      "description": "Stores audio recording metadata for a specific user. The actual audio is in Cloud Storage."
    }
  }
}
